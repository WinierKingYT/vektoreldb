VDB_ENV=dev
VDB_DATA_DIR=data
VDB_QDRANT_URL=path:qdrant_storage
VDB_COLLECTION_NAME=personal_documents_v1
# Dense is the default. Set hybrid only for the opt-in V1.2 experiment.
VDB_RETRIEVAL_MODE=dense
VDB_HYBRID_COLLECTION_NAME=personal_documents_hybrid_v1
VDB_LATE_COLLECTION_NAME=personal_documents_late_v1
VDB_QUANTIZED_COLLECTION_NAME=personal_documents_quantized_v1
# Off by default; lexical is an offline V1.3 control reranker.
VDB_RERANKER_MODE=off
# Off by default; selectivity enables V1.4 filtered-search planning.
VDB_QUERY_PLANNER_MODE=off
VDB_EMBEDDING_PROVIDER=local
# Set to openai only with an explicit privacy/cost decision and OPENAI_API_KEY.
VDB_EMBEDDING_MODEL=intfloat/multilingual-e5-base
VDB_EMBEDDING_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
# Set true to fail fast when the pinned local model is not fully cached.
VDB_EMBEDDING_OFFLINE=false
VDB_SOURCE_MAX_BYTES=10000000
# External provider only: HTTPS-compatible /v1 endpoint; HTTP is for loopback
# test endpoints only. Timeout, retries, batch and cache are bounded.
# VDB_EMBEDDING_BASE_URL=https://api.openai.com/v1
# VDB_EMBEDDING_TIMEOUT_SECONDS=30
# VDB_EMBEDDING_MAX_RETRIES=2
# VDB_EMBEDDING_BATCH_SIZE=32
# VDB_EMBEDDING_CACHE_SIZE=256
VDB_VECTOR_DIMENSION=768
VDB_DISTANCE_METRIC=cosine
# Optional calibrated abstention floor; uncomment only after final benchmark calibration.
# VDB_RETRIEVAL_MIN_SCORE=0.70
# VDB_HNSW_EF=64
