{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-vector-db.local/schemas/query-labels.schema.json",
  "title": "Query relevance labels",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["query_id", "relevant_chunk_ids", "annotator", "annotated_at", "source", "decision_note", "corpus_checksum", "parser_version", "chunking_version"],
    "properties": {
      "query_id": {"type": "string", "minLength": 1},
      "relevant_chunk_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "annotator": {"type": "string", "minLength": 1},
      "annotated_at": {"type": "string", "minLength": 1},
      "source": {"enum": ["manual", "derived", "reviewed"]},
      "decision_note": {"type": "string", "minLength": 1},
      "corpus_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
      "parser_version": {"type": "string", "minLength": 1},
      "parser_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "chunking_version": {"type": "string", "minLength": 1}
    }
  }
}
