{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-vector-db.local/schemas/corpus-quality-report.schema.json",
  "title": "Privacy-safe corpus extraction quality report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_count", "parsed_source_count", "failed_source_count",
    "empty_extraction_count", "duplicate_count", "total_bytes", "total_extracted_chars",
    "total_chunks", "formats", "privacy_classification"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "corpus-quality-report-v1"},
    "source_count": {"type": "integer", "minimum": 0},
    "parsed_source_count": {"type": "integer", "minimum": 0},
    "failed_source_count": {"type": "integer", "minimum": 0},
    "empty_extraction_count": {"type": "integer", "minimum": 0},
    "duplicate_count": {"type": "integer", "minimum": 0},
    "total_bytes": {"type": "integer", "minimum": 0},
    "total_extracted_chars": {"type": "integer", "minimum": 0},
    "total_chunks": {"type": "integer", "minimum": 0},
    "formats": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_count", "parsed_count", "failed_count", "empty_extraction_count",
          "duplicate_count", "total_bytes", "total_extracted_chars", "total_chunks",
          "parser_versions", "failure_types"
        ],
        "properties": {
          "source_count": {"type": "integer", "minimum": 0},
          "parsed_count": {"type": "integer", "minimum": 0},
          "failed_count": {"type": "integer", "minimum": 0},
          "empty_extraction_count": {"type": "integer", "minimum": 0},
          "duplicate_count": {"type": "integer", "minimum": 0},
          "total_bytes": {"type": "integer", "minimum": 0},
          "total_extracted_chars": {"type": "integer", "minimum": 0},
          "total_chunks": {"type": "integer", "minimum": 0},
          "parser_versions": {"type": "array", "items": {"type": "string"}},
          "failure_types": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "privacy_classification": {"type": "string", "const": "private-local"}
  }
}
