{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "root_name", "corpus_checksum", "source_count", "parsed_source_count", "failed_source_count", "total_bytes", "total_chunks", "chunk_ids", "chunking_version", "parser_versions", "privacy_classification"],
  "properties": {
    "schema_version": { "type": "string", "const": "corpus-manifest-v1" },
    "root_name": { "type": "string", "minLength": 1 },
    "corpus_checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source_count": { "type": "integer", "minimum": 0 },
    "parsed_source_count": { "type": "integer", "minimum": 0 },
    "failed_source_count": { "type": "integer", "minimum": 0 },
    "total_bytes": { "type": "integer", "minimum": 0 },
    "total_chunks": { "type": "integer", "minimum": 0 },
    "total_extracted_chars": { "type": "integer", "minimum": 0 },
    "empty_extraction_count": { "type": "integer", "minimum": 0 },
    "size_bucket_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "chunk_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "chunk_size_buckets": { "type": "object", "additionalProperties": { "enum": ["small", "medium", "large"] } },
    "chunking_version": { "type": "string", "minLength": 1 },
    "parser_versions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "format_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "failure_types": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "duplicate_count": { "type": "integer", "minimum": 0 },
    "privacy_classification": { "type": "string", "const": "private-local" }
  }
}
